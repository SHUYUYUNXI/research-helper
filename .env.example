# ReachKit environment variable examples; all entries are placeholders.
# Set variables in the process environment. ReachKit does not auto-load .env.
# For saved configuration, use reachkit configure --help (hidden input).
# Saved ~/.agent-reach/config.yaml values take precedence over environment values.

# EXA_API_KEY=YOUR_EXA_API_KEY
# GITHUB_TOKEN=YOUR_GITHUB_TOKEN
# PROXY=http://YOUR_PROXY_HOST:PORT
# GROQ_API_KEY=YOUR_GROQ_API_KEY
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# TWITTER_AUTH_TOKEN=YOUR_AUTH_TOKEN
# TWITTER_CT0=YOUR_CT0

# Transcription uses one configured provider by default.
# --allow-provider-fallback explicitly permits sending audio to another provider.
